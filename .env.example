# =========================
# Discord
# =========================

DISCORD_BOT_TOKEN=your_discord_bot_token_here


# =========================
# MySQL / MariaDB
# =========================

# Docker Linux:
# Use host.docker.internal when MariaDB runs directly on the Docker host.
#
# If MariaDB is another Docker Compose service, use its service name instead,
# for example: mariadb
BOT_DB_HOST=host.docker.internal

BOT_DB_PORT=3306
BOT_DB_USER=monitoriabot
BOT_DB_PASS=change_me
BOT_DB_NAME=monitoriabot